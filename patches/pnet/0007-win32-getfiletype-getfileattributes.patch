Why: cscc/ilrun shortcut.  On native Win32 ILGetFileType() used 
_findfirst(path), which finds nothing for drive roots and for directories 
given with a trailing separator.  pnetlib's Path.GetFullPath(".") returns 
'E:\\dir\\', so Directory.Exists(Path.GetFullPath(".")) was false and 
AssemblyBuilder.Save threw ArgumentException: Mono's mcs running on ilrun 
could compile hello world but not write it.  Use GetFileAttributesA.  New 
patch (not in Guix).

diff --git a/support/dir.c b/support/dir.c
index eb5c1b2..359cdec 100644
--- a/support/dir.c
+++ b/support/dir.c
@@ -381,25 +381,19 @@ int ILDirEntType(ILDirEnt *entry)
 
 int ILGetFileType(const char *path)
 {
-	struct _finddata_t fileinfo;
-	intptr_t handle;
-	handle = _findfirst(path, &fileinfo);
-	if(handle >= 0)
+	/* GetFileAttributes, unlike _findfirst, accepts drive roots and
+	   paths with a trailing separator ("C:\\dir\\", as produced by
+	   Path.GetFullPath(".")). */
+	DWORD attrs = GetFileAttributesA(path);
+	if(attrs == INVALID_FILE_ATTRIBUTES)
 	{
-		_findclose(handle);
-		if((fileinfo.attrib & _A_SUBDIR) != 0)
-		{
-			return ILFileType_DIR;
-		}
-		else
-		{
-			return ILFileType_REG;
-		}
+		return ILFileType_Unknown;
 	}
-	else
+	if((attrs & FILE_ATTRIBUTE_DIRECTORY) != 0)
 	{
-		return ILFileType_Unknown;
+		return ILFileType_DIR;
 	}
+	return ILFileType_REG;
 }
 
