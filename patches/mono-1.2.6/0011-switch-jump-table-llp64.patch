Why: LLP64.  The CEE_SWITCH lowering marks the jump-table load with the 
magic offset (long)0xf0f0f0f0f0f0f0f1LL so that the amd64 backend, seeing a 
non-imm32 offset, turns it into 'mov $imm64, reg' that the SWITCH patch 
fills with the 64-bit table address.  On Win64 'long' is 32 bits: the 
offset becomes 0xf0f0f0f1, fits imm32, a '[reg+disp32]' load is emitted and 
later patched as if it were RIP-relative (target-7).  Seen on MSYS2 UCRT64: 
#GP on 'jmp *%rax' after 'mov 0x1d467d9(%rax),%rax' in the first switch 
statement mcs runs.  Use gssize.  New patch (not in Guix).

diff --git a/mono/mini/inssel.brg b/mono/mini/inssel.brg
index 48229915..618803d0 100644
--- a/mono/mini/inssel.brg
+++ b/mono/mini/inssel.brg
@@ -846,7 +846,7 @@ stmt: CEE_SWITCH (reg) "2" {
 		 /* the backend must patch the address. we use 0xf0f0f0f0 to avoid the usage 
 		  * of special (short) opcodes on x86 */
 		if (sizeof (gpointer) == 8)
-			MONO_EMIT_NEW_LOAD_MEMBASE (s, target_reg, offset_reg, (long)0xf0f0f0f0f0f0f0f1LL);
+			MONO_EMIT_NEW_LOAD_MEMBASE (s, target_reg, offset_reg, (gssize)0xf0f0f0f0f0f0f0f1LL);
 		else
 			MONO_EMIT_NEW_LOAD_MEMBASE (s, target_reg, offset_reg, 0xf0f0f0f0);
 	}
