Why: MSBuild 17.8 is the last release with MonoBuild support, but the Mono CI has been off since 2021 (dotnet/msbuild#6058) and the MONO code paths rotted: a syntax error in Toolset.cs, a missing using for SecurityCritical, a Memory-based ReadAsync that only exists on .NET Core, an mcs-only lambda workaround in FileMatcher.cs that no longer compiles with Roslyn, and two Tasks files that use ManifestUtilities/Microsoft.IO which MonoBuild excludes. Also: Mono keeps .NETFramework reference assemblies in lib/mono/4.7.2-api and points at them from xbuild-frameworks/.NETFramework/v4.7.2/RedistList/FrameworkList.xml (TargetFrameworkDirectory); only use $(TargetFrameworkRootPath)\.NETFramework\vX as FrameworkPathOverride when it really contains mscorlib.dll, so the GetPathToStandardLibraries fallback finds Mono's reference assemblies instead of the Windows .NET Framework runtime directory.

--- a/src/Build/Definition/Toolset.cs
+++ b/src/Build/Definition/Toolset.cs
@@ -916,7 +916,7 @@
 #if RUNTIME_TYPE_NETCORE
                     Traits.Instance.ForceEvaluateAsFullFramework ? "Full" : "Core",
 #elif MONO
-                    NativeMethodsShared.IsMono ? "Mono" : "Full");
+                    NativeMethodsShared.IsMono ? "Mono" : "Full",
 #else
                     "Full",
 #endif
--- a/src/Shared/CommunicationsUtilities.cs
+++ b/src/Shared/CommunicationsUtilities.cs
@@ -547,7 +547,7 @@
             int totalBytesRead = 0;
             while (totalBytesRead < bytesToRead)
             {
-                int bytesRead = await stream.ReadAsync(buffer.AsMemory(totalBytesRead, bytesToRead - totalBytesRead), CancellationToken.None);
+                int bytesRead = await stream.ReadAsync(buffer, totalBytesRead, bytesToRead - totalBytesRead, CancellationToken.None);
                 if (bytesRead == 0)
                 {
                     return totalBytesRead;
--- a/src/Shared/FileMatcher.cs
+++ b/src/Shared/FileMatcher.cs
@@ -1697,7 +1697,7 @@
