From 313162980ff02d965a554a80cea066467e44b861 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Fri, 9 Oct 2026 17:26:08 +0200
Subject: [PATCH] coreclr: an ETW header without mc.exe (genEtwProvider.py
 --nomc)

The Windows ETW provider header (ClrEtwAll.h) is generated by the SDK's
mc.exe -um. With --nomc (used for MinGW) the script writes it from the
manifest: provider GUIDs, registration handles and trace contexts, the
EVENT_DESCRIPTORs, task GUIDs and keyword/task/opcode symbols. The
providers are not registered, so ETW stays off; EventPipe, which uses the
same descriptors and keywords, works. etwStackSupportedEvents is
selectany for clang; ETW_INLINE functions of eventtrace.cpp are not
inline with clang (they are called from other files); the token pasting
in ETWOnStartup is valid C++ now.
---
 src/coreclr/inc/eventtracebase.h              |   2 +-
 src/coreclr/scripts/genEtwProvider.py         | 150 +++++++++++++++++-
 .../vm/eventing/EtwProvider/CMakeLists.txt    |   8 +-
 src/coreclr/vm/eventtrace.cpp                 |   7 +
 4 files changed, 160 insertions(+), 7 deletions(-)

diff --git a/src/coreclr/inc/eventtracebase.h b/src/coreclr/inc/eventtracebase.h
index 3648b1f3a..a9097000e 100644
--- a/src/coreclr/inc/eventtracebase.h
+++ b/src/coreclr/inc/eventtracebase.h
@@ -211,7 +211,7 @@ struct ProfilingScanContext;
     (ETW_TRACING_INITIALIZED(Context.EtwProvider->RegistrationHandle) && ETW_CATEGORY_ENABLED(Context, Level, Keyword))
 
 #define ETWOnStartup(StartEventName, EndEventName) \
-    ETWTraceStartup trace##StartEventName##(Microsoft_Windows_DotNETRuntimePrivateHandle, &StartEventName, &StartupId, &EndEventName, &StartupId);
+    ETWTraceStartup trace##StartEventName(Microsoft_Windows_DotNETRuntimePrivateHandle, &StartEventName, &StartupId, &EndEventName, &StartupId);
 #define ETWFireEvent(EventName) FireEtw##EventName(GetClrInstanceId())
 
 #ifndef FEATURE_NATIVEAOT
diff --git a/src/coreclr/scripts/genEtwProvider.py b/src/coreclr/scripts/genEtwProvider.py
index 854118284..49ddb2e51 100644
--- a/src/coreclr/scripts/genEtwProvider.py
+++ b/src/coreclr/scripts/genEtwProvider.py
@@ -43,12 +43,148 @@ This file is generated using the logic from <root>/src/scripts/genEtwProvider.py
 ******************************************************************/
 """
 
-def genProviderInterface(manifest, intermediate):
+# Standard opcode and level values of the Windows event manifest schema (winmeta.xml)
+win_opcodes = {"win:Info": 0, "win:Start": 1, "win:Stop": 2, "win:DC_Start": 3, "win:DC_Stop": 4,
+               "win:Extension": 5, "win:Reply": 6, "win:Resume": 7, "win:Suspend": 8, "win:Send": 9,
+               "win:Receive": 240}
+win_levels = {"win:LogAlways": 0, "win:Critical": 1, "win:Error": 2, "win:Warning": 3,
+              "win:Informational": 4, "win:Verbose": 5}
+
+def genProviderInterfaceNoMC(manifest, provider_dirname):
+    """Writes ClrEtwAll.h without mc.exe (for toolchains without the Windows SDK, e.g.
+    MinGW): the provider GUIDs, registration handles and trace contexts, the event
+    descriptors and the keyword/task/opcode symbols mc would define, so that the
+    Windows code compiles unchanged. The providers are not registered with ETW, so
+    every ETW enabled-check is false and the FireEtXplat* writes are no-ops; EventPipe
+    (which uses the same descriptors) is unaffected."""
+    tree = DOM.parse(manifest)
+    out = [stdprolog_cpp, """
+#pragma once
+#include <evntprov.h>
+
+#ifndef ETW_INLINE
+#define ETW_INLINE DECLSPEC_NOINLINE __inline
+#endif
+
+#ifndef MCGEN_TRACE_CONTEXT_DEF
+#define MCGEN_TRACE_CONTEXT_DEF
+typedef struct _MCGEN_TRACE_CONTEXT
+{
+    TRACEHANDLE            RegistrationHandle;
+    TRACEHANDLE            Logger;
+    ULONGLONG              MatchAnyKeyword;
+    ULONGLONG              MatchAllKeyword;
+    ULONG                  Flags;
+    ULONG                  IsEnabled;
+    UCHAR                  Level;
+    UCHAR                  Reserve;
+    USHORT                 EnableBitsCount;
+    PULONG                 EnableBitMask;
+    const ULONGLONG*       EnableKeyWords;
+    const UCHAR*           EnableLevel;
+} MCGEN_TRACE_CONTEXT, *PMCGEN_TRACE_CONTEXT;
+#endif
+
+// mc's McGenEventEnabled (renamed like the rest, see genEtwProvider.py)
+FORCEINLINE BOOLEAN McGenEventXplatEnabled(PMCGEN_TRACE_CONTEXT EnableInfo, PCEVENT_DESCRIPTOR EventDescriptor)
+{
+    if (!EnableInfo || !EnableInfo->IsEnabled)
+        return FALSE;
+    if ((EventDescriptor->Level <= EnableInfo->Level) || (EnableInfo->Level == 0))
+    {
+        if ((EventDescriptor->Keyword == (ULONGLONG)0) ||
+            ((EventDescriptor->Keyword & EnableInfo->MatchAnyKeyword) &&
+             ((EventDescriptor->Keyword & EnableInfo->MatchAllKeyword) == EnableInfo->MatchAllKeyword)))
+            return TRUE;
+    }
+    return FALSE;
+}
+"""]
+    def num(v):
+        return int(v, 0)
+    defined = set()
+    def define(name, value):
+        # some keyword symbols are declared by several providers
+        if name not in defined:
+            defined.add(name)
+            out.append("#define %s 0x%x\n" % (name, value))
+    for providerNode in tree.getElementsByTagName('provider'):
+        pname = providerNode.getAttribute('name')
+        psym = providerNode.getAttribute('symbol')
+        guid = providerNode.getAttribute('guid').strip('{}')
+        g = guid.split('-')
+        handle = pname.replace('-', '_') + "Handle"
+        out.append("\n// Provider %s\n" % pname)
+        out.append("EXTERN_C __declspec(selectany) const GUID %s = {0x%s, 0x%s, 0x%s, {0x%s, 0x%s, %s}};\n" % (
+            psym, g[0], g[1], g[2], g[3][0:2], g[3][2:4], ", ".join("0x" + g[4][i:i+2] for i in range(0, 12, 2))))
+        out.append("EXTERN_C __declspec(selectany) REGHANDLE %s = (REGHANDLE)0;\n" % handle)
+        out.append("EXTERN_C __declspec(selectany) MCGEN_TRACE_CONTEXT %s_Context = {0};\n" % psym)
+        reg = pname.replace('-', '_')
+        out.append("#define EventRegister%s() ((ULONG)ERROR_SUCCESS)\n" % reg)
+        out.append("#define EventUnregister%s() ((ULONG)ERROR_SUCCESS)\n" % reg)
+
+        keywords = {}
+        for k in providerNode.getElementsByTagName('keyword'):
+            keywords[k.getAttribute('name')] = num(k.getAttribute('mask'))
+            if k.getAttribute('symbol'):
+                define(k.getAttribute('symbol'), num(k.getAttribute('mask')))
+        tasks = {}
+        opcodes = {}   # (task, name) -> value; (None, name) for provider-wide opcodes
+        for t in providerNode.getElementsByTagName('task'):
+            tasks[t.getAttribute('name')] = num(t.getAttribute('value'))
+            if t.getAttribute('eventGUID'):
+                tg = t.getAttribute('eventGUID').strip('{}').split('-')
+                out.append("EXTERN_C __declspec(selectany) const GUID %sId = {0x%s, 0x%s, 0x%s, {0x%s, 0x%s, %s}};\n" % (
+                    t.getAttribute('name'), tg[0], tg[1], tg[2], tg[3][0:2], tg[3][2:4], ", ".join("0x" + tg[4][i:i+2] for i in range(0, 12, 2))))
+            if t.getAttribute('symbol'):
+                define(t.getAttribute('symbol'), num(t.getAttribute('value')))
+            for o in t.getElementsByTagName('opcode'):
+                opcodes[(t.getAttribute('name'), o.getAttribute('name'))] = num(o.getAttribute('value'))
+                if o.getAttribute('symbol'):
+                    define(o.getAttribute('symbol'), num(o.getAttribute('value')))
+        for o in providerNode.getElementsByTagName('opcode'):
+            if o.parentNode.tagName != 'task':
+                opcodes[(None, o.getAttribute('name'))] = num(o.getAttribute('value'))
+        for e in providerNode.getElementsByTagName('event'):
+            sym = e.getAttribute('symbol')
+            task = e.getAttribute('task')
+            op = e.getAttribute('opcode')
+            if op in win_opcodes:
+                opv = win_opcodes[op]
+            elif (task, op) in opcodes:
+                opv = opcodes[(task, op)]
+            elif (None, op) in opcodes:
+                opv = opcodes[(None, op)]
+            elif op == "":
+                opv = 0
+            else:
+                raise Exception("unknown opcode %s for event %s" % (op, sym))
+            lvl = win_levels[e.getAttribute('level')] if e.getAttribute('level') else 0
+            kw = 0
+            for k in e.getAttribute('keywords').split():
+                kw |= keywords[k]
+            out.append("EXTERN_C __declspec(selectany) const EVENT_DESCRIPTOR %s = {0x%x, 0x%x, 0x0, 0x%x, 0x%x, 0x%x, 0x%xULL};\n" % (
+                sym, num(e.getAttribute('value')), num(e.getAttribute('version') or "0"), lvl, opv, tasks.get(task, 0), kw))
+            out.append("#define EventXplatEnabled%s() McGenEventXplatEnabled(&%s_Context, &%s)\n" % (sym, psym, sym))
+            out.append("#define FireEtXplat%s(...) ((ULONG)ERROR_SUCCESS)\n" % sym)
+    with open(path.join(provider_dirname, mcheader_filename), 'w') as f:
+        f.write(''.join(out))
+    # no message table / WEVT_TEMPLATE resources
+    with open(path.join(provider_dirname, "ClrEtwAll.rc"), 'w') as f:
+        f.write("// ClrEtwAll.rc: no ETW manifest resources (generated without mc.exe)\n")
+    for name in ("ClrEtwAll_MSG00001.bin", "ClrEtwAllTEMP.bin"):
+        open(path.join(provider_dirname, name), 'wb').close()
+
+def genProviderInterface(manifest, intermediate, nomc=False):
     provider_dirname = os.path.join(intermediate, etw_dirname + "_temp")
 
     if not os.path.exists(provider_dirname):
         os.makedirs(provider_dirname)
 
+    if nomc:
+        genProviderInterfaceNoMC(manifest, provider_dirname)
+        return
+
     cmd = ['mc.exe', '-h', provider_dirname, '-r', provider_dirname, '-b', '-co', '-um', '-p', 'FireEtXplat', manifest]
     subprocess.check_call(cmd)
 
@@ -164,7 +300,9 @@ def genEtwMacroHeader(manifest, exclusion_filename, intermediate):
 
         header_file.write("#define NO_OF_ETW_PROVIDERS " + str(numOfProviders) + "\n")
         header_file.write("#define MAX_BYTES_PER_ETW_PROVIDER " + str(nMaxEventBytesPerProvider) + "\n")
-        header_file.write("EXTERN_C constexpr BYTE etwStackSupportedEvents[NO_OF_ETW_PROVIDERS][MAX_BYTES_PER_ETW_PROVIDER] = \n{\n")
+        # (one definition per translation unit: MinGW (clang, GCC) needs it to be selectany, MSVC merges them itself)
+        header_file.write("#if defined(__GNUC__) && !defined(_MSC_VER)\n#define ETW_STACK_SUPPORTED_EVENTS_SELECTANY __declspec(selectany)\n#else\n#define ETW_STACK_SUPPORTED_EVENTS_SELECTANY\n#endif\n")
+        header_file.write("EXTERN_C ETW_STACK_SUPPORTED_EVENTS_SELECTANY constexpr BYTE etwStackSupportedEvents[NO_OF_ETW_PROVIDERS][MAX_BYTES_PER_ETW_PROVIDER] = \n{\n")
 
         for providerNode in tree.getElementsByTagName('provider'):
             stackSupportedEvents = [0]*nMaxEventBytesPerProvider
@@ -205,11 +343,11 @@ def genEtwMacroHeader(manifest, exclusion_filename, intermediate):
             header_file.write(''.join(line) + "\n")
         header_file.write("};\n")
 
-def genFiles(manifest, intermediate, exclusion_filename):
+def genFiles(manifest, intermediate, exclusion_filename, nomc=False):
     if not os.path.exists(intermediate):
         os.makedirs(intermediate)
 
-    genProviderInterface(manifest, intermediate)
+    genProviderInterface(manifest, intermediate, nomc)
     genEtwMacroHeader(manifest, exclusion_filename, intermediate)
     genXplatHeader(intermediate)
 
@@ -225,6 +363,8 @@ def main(argv):
                                     help='full path to exclusion list')
     required.add_argument('--intermediate', type=str, required=True,
                                     help='full path to eventprovider  intermediate directory')
+    parser.add_argument('--nomc', action='store_true',
+                                    help='do not run mc.exe; write an ETW header that compiles but never enables the providers')
     args, unknown = parser.parse_known_args(argv)
     if unknown:
         print('Unknown argument(s): ', ', '.join(unknown))
@@ -235,7 +375,7 @@ def main(argv):
     intermediate       = args.intermediate
 
     checkConsistency(manifest, exclusion_filename)
-    genFiles(manifest, intermediate, exclusion_filename)
+    genFiles(manifest, intermediate, exclusion_filename, args.nomc)
 
     # Update the final directory from temp
     provider_temp_dirname = os.path.join(intermediate, etw_dirname + "_temp")
diff --git a/src/coreclr/vm/eventing/EtwProvider/CMakeLists.txt b/src/coreclr/vm/eventing/EtwProvider/CMakeLists.txt
index 3bc2b8c67..036d7afb7 100644
--- a/src/coreclr/vm/eventing/EtwProvider/CMakeLists.txt
+++ b/src/coreclr/vm/eventing/EtwProvider/CMakeLists.txt
@@ -2,6 +2,12 @@ include(FindPythonInterp)
 
 set(ETW_PROVIDER_SCRIPT ${CLR_DIR}/scripts/genEtwProvider.py)
 
+if(MINGW)
+  # no mc.exe: the ETW header is generated by the script; the providers are not
+  # registered (ETW events are off, EventPipe works)
+  set(ETW_PROVIDER_NOMC --nomc)
+endif()
+
 set (ETW_PROVIDER_OUTPUTS
   ${GENERATED_INCLUDE_DIR}/etw/ClrEtwAll.h
   ${GENERATED_INCLUDE_DIR}/etw/ClrEtwAll.rc
@@ -15,7 +21,7 @@ set_source_files_properties(${ETW_PROVIDER_OUTPUTS} PROPERTIES GENERATED TRUE)
 
 add_custom_command(
   OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_CFG_INTDIR}/eventprovider.timestamp
-  COMMAND ${PYTHON_EXECUTABLE} ${ETW_PROVIDER_SCRIPT} --man ${EVENT_MANIFEST} --exc ${EVENT_EXCLUSIONS} --intermediate ${GENERATED_INCLUDE_DIR}
+  COMMAND ${PYTHON_EXECUTABLE} ${ETW_PROVIDER_SCRIPT} --man ${EVENT_MANIFEST} --exc ${EVENT_EXCLUSIONS} --intermediate ${GENERATED_INCLUDE_DIR} ${ETW_PROVIDER_NOMC}
   COMMAND ${CMAKE_COMMAND} -E touch ${CMAKE_CURRENT_BINARY_DIR}/${CMAKE_CFG_INTDIR}/eventprovider.timestamp
   DEPENDS ${EVENT_MANIFEST} ${EVENT_EXCLUSIONS} ${ETW_PROVIDER_SCRIPT})
 
diff --git a/src/coreclr/vm/eventtrace.cpp b/src/coreclr/vm/eventtrace.cpp
index 9498f00ed..0e667186b 100644
--- a/src/coreclr/vm/eventtrace.cpp
+++ b/src/coreclr/vm/eventtrace.cpp
@@ -43,6 +43,13 @@
 
 #include "eventtracepriv.h"
 
+#if defined(__MINGW32__) && defined(ETW_INLINE)
+// The functions defined here with ETW_INLINE (EtwCallout, EtwCallback, ...) are
+// called from other files; with clang an inline function is only emitted where used.
+#undef ETW_INLINE
+#define ETW_INLINE DECLSPEC_NOINLINE
+#endif
+
 #ifndef HOST_UNIX
 DOTNET_TRACE_CONTEXT MICROSOFT_WINDOWS_DOTNETRUNTIME_PROVIDER_DOTNET_Context = { &MICROSOFT_WINDOWS_DOTNETRUNTIME_PROVIDER_Context, MICROSOFT_WINDOWS_DOTNETRUNTIME_PROVIDER_EVENTPIPE_Context };
 DOTNET_TRACE_CONTEXT MICROSOFT_WINDOWS_DOTNETRUNTIME_PRIVATE_PROVIDER_DOTNET_Context = { &MICROSOFT_WINDOWS_DOTNETRUNTIME_PRIVATE_PROVIDER_Context, MICROSOFT_WINDOWS_DOTNETRUNTIME_PRIVATE_PROVIDER_EVENTPIPE_Context };
-- 
