diff --git a/src/coreclr/dlls/mscorrc/mscorrc.rc b/src/coreclr/dlls/mscorrc/mscorrc.rc
index 8c3c50d4f..177fd1b87 100644
--- a/src/coreclr/dlls/mscorrc/mscorrc.rc
+++ b/src/coreclr/dlls/mscorrc/mscorrc.rc
@@ -40,6 +40,33 @@ LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
 #define SMAKEHR(val)    val
 #define EMAKEHR(val)    val
 
+// String IDs are 16 bits: rc.exe keeps the low word of the IDs that are
+// Windows HRESULTs (E_ACCESSDENIED, HRESULT_FROM_WIN32(...)), as LoadString does;
+// llvm-rc rejects them. Spell out the low word for it.
+#ifdef __clang__
+#undef _HRESULT_TYPEDEF_
+#define _HRESULT_TYPEDEF_(sc) ((sc) & 0xFFFF)
+#undef __HRESULT_FROM_WIN32
+#define __HRESULT_FROM_WIN32(x) ((x) & 0xFFFF)
+#undef HRESULT_FROM_WIN32
+#define HRESULT_FROM_WIN32(x) ((x) & 0xFFFF)
+// the HRESULT-valued IDS_ of resource.h
+#undef IDS_EE_FILE_NOT_FOUND
+#define IDS_EE_FILE_NOT_FOUND                   0x0002
+#undef IDS_EE_PATH_TOO_LONG
+#define IDS_EE_PATH_TOO_LONG                    0x006F
+#undef IDS_EE_PROC_NOT_FOUND
+#define IDS_EE_PROC_NOT_FOUND                   0x007F
+#undef IDS_EE_ALREADY_EXISTS
+#define IDS_EE_ALREADY_EXISTS                   0x00B7
+#undef IDS_EE_BAD_USER_PROFILE
+#define IDS_EE_BAD_USER_PROFILE                 0x04E5
+#undef IDS_INET_E_SECURITY_PROBLEM
+#define IDS_INET_E_SECURITY_PROBLEM             0x000E
+#undef IDS_CLASSLOAD_GENERAL
+#define IDS_CLASSLOAD_GENERAL                   0x1522
+#endif
+
