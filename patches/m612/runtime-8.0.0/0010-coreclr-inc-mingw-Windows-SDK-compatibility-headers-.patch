From 6d0162deb625a468cd23bf6646467f250cf7bb67 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Fri, 9 Oct 2026 17:26:08 +0200
Subject: [PATCH] coreclr: inc/mingw, Windows SDK compatibility headers for
 MinGW

- msvc_compat.h (force-included): __annotation, the windows.h min/max
  macros for C++, crtdbg.h (as MSVC's C++ headers include it), missing
  winnt.h/winerror.h constants, an _rdsspq() with MSVC's signature.
- sal_legacy.h: the SAL 1 annotations (__in, __success(x) ...) mingw-w64
  does not define, empty as outside /analyze (names from pal/inc/rt).
- winnt.h: wraps mingw-w64's; KNONVOLATILE_CONTEXT_POINTERS with the
  SDK's named members (Rax..R15, Xmm0..Xmm15), C_ASSERT as static_assert.
- verrsrc.h: mingw-w64 has it in winver.h.
---
 src/coreclr/inc/mingw/msvc_compat.h |   61 ++
 src/coreclr/inc/mingw/sal_legacy.h  | 1253 +++++++++++++++++++++++++++
 src/coreclr/inc/mingw/verrsrc.h     |    4 +
 src/coreclr/inc/mingw/winnt.h       |   52 ++
 4 files changed, 1370 insertions(+)
 create mode 100644 src/coreclr/inc/mingw/msvc_compat.h
 create mode 100644 src/coreclr/inc/mingw/sal_legacy.h
 create mode 100644 src/coreclr/inc/mingw/verrsrc.h
 create mode 100644 src/coreclr/inc/mingw/winnt.h

diff --git a/src/coreclr/inc/mingw/msvc_compat.h b/src/coreclr/inc/mingw/msvc_compat.h
new file mode 100644
index 000000000..71d716469
--- /dev/null
+++ b/src/coreclr/inc/mingw/msvc_compat.h
@@ -0,0 +1,61 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+// Force-included into every C/C++ file of CoreCLR when it is built by clang with
+// the GNU driver for Windows (MinGW, x86_64-w64-mingw32).  It stands in for the
+// MSVC-only intrinsics the Windows code paths use; the Unix build gets the same
+// definitions from pal.h.
+#pragma once
+
+// MSVC debugger annotations (no code is generated for them)
+#define __annotation(...) ((void)0)
+
+// mingw-w64's sal.h (SAL 2: _In_, _Out_writes_(n) ...) and the legacy SAL 1
+// names (__in, __success(expr) ...) the SDK also defines.
+#include <sal.h>
+#include "sal_legacy.h"
+
+// windows.h defines min/max as macros (unless NOMINMAX); mingw-w64 only does so
+// for C. The Windows code of CoreCLR relies on them in C++ too. (libc++ saves and
+// undefines them around its own min/max.)
+#ifndef NOMINMAX
+#ifndef max
+#define max(a, b) (((a) > (b)) ? (a) : (b))
+#endif
+#ifndef min
+#define min(a, b) (((a) < (b)) ? (a) : (b))
+#endif
+#endif
+
+// winnt.h (ReplacesCorHdrNumericDefines) constants missing from mingw-w64
+#ifndef COMIMAGE_FLAGS_NATIVE_ENTRYPOINT
+#define COMIMAGE_FLAGS_NATIVE_ENTRYPOINT 0x00000010
+#endif
+
+// MSVC's C++ library headers bring in crtdbg.h (_ASSERTE, _RPT*), and the
+// standalone GC environment relies on that.
+#if defined(__cplusplus)
+#include <crtdbg.h>
+#endif
+
+// _rdsspq(): MSVC's intrinsic takes no argument; clang's takes the value to return
+// when CET is off and needs the shstk target feature. RDSSP is a NOP on processors
+// (and in processes) without CET shadow stacks, so the register keeps its 0.
+#if defined(__cplusplus) && defined(__x86_64__)
+#include <intrin.h>     // (cetintrin.h declares clang's _rdsspq; it must come before the macro)
+static __inline__ unsigned long long __clr_mingw_rdsspq(void)
+{
+    unsigned long long ssp = 0;
+    __asm__ __volatile__("rdsspq %0" : "+r"(ssp));
+    return ssp;
+}
+#define _rdsspq() __clr_mingw_rdsspq()
+#endif
+
+// winerror.h (Windows Runtime) HRESULTs missing from mingw-w64
+#ifndef RO_E_METADATA_NAME_NOT_FOUND
+#define RO_E_METADATA_NAME_NOT_FOUND ((HRESULT)0x8000000FL)
+#endif
+#ifndef RO_E_CLOSED
+#define RO_E_CLOSED ((HRESULT)0x80000013L)
+#endif
