diff --git a/src/coreclr/inc/mingw/msvc_compat.h b/src/coreclr/inc/mingw/msvc_compat.h
index e86eff886..9d7d6376e 100644
--- a/src/coreclr/inc/mingw/msvc_compat.h
+++ b/src/coreclr/inc/mingw/msvc_compat.h
@@ -1,12 +1,46 @@
 // Licensed to the .NET Foundation under one or more agreements.
 // The .NET Foundation licenses this file to you under the MIT license.
 
-// Force-included into every C/C++ file of CoreCLR when it is built by clang with
-// the GNU driver for Windows (MinGW, x86_64-w64-mingw32).  It stands in for the
-// MSVC-only intrinsics the Windows code paths use; the Unix build gets the same
-// definitions from pal.h.
+// Force-included into every C/C++ file of CoreCLR when it is built by clang or
+// GCC with the GNU driver for Windows (MinGW, x86_64-w64-mingw32).  It stands in
+// for the MSVC-only intrinsics the Windows code paths use; the Unix build gets
+// the same definitions from pal.h.
 #pragma once
 
+// SEH try statements are written __seh_try { } __except (f) { } __endtry (or
+// __finally). With clang that is __try; with GCC it is ReactOS's PSEH (with
+// gcc_plugin_seh), whose try is spelt __seh_try because libstdc++ already uses
+// __try as its own spelling of try, and which needs __endtry after the handler.
+#if defined(__cplusplus) && defined(__GNUC__) && !defined(__clang__)
+// excpt.h first: it declares _exception_code() & co., which PSEH defines as macros
+#include <excpt.h>
+#pragma push_macro("__try")
+#include <pseh/pseh2_64.h>
+#pragma pop_macro("__try")
+#define __seh_try _SEH2_TRY
+// MSVC's intrinsic; mingw-w64's intrin.h only declares it (after which the macro)
+#include <intrin.h>
+#define _ReturnAddress() __builtin_return_address(0)
+// GetExceptionCode()/GetExceptionInformation() are excpt.h's _exception_code()/
+// _exception_info(); PSEH makes those function-like macros, which would also
+// rewrite CoreCLR members called GetExceptionCode(). Keep them names, and give
+// each filter local lambdas of those names that read PSEH's state.
+#undef _exception_code
+#undef _exception_info
+#undef _abnormal_termination
+#undef __except
+#define __except(...) _SEH2_EXCEPT(({                                                  \
+    auto _exception_code = [&]() -> unsigned long { return __seh2$$exception_code__; }; \
+    auto _exception_info = [&]() -> struct _EXCEPTION_POINTERS* {                       \
+        return (struct _EXCEPTION_POINTERS*)__seh2$$exception_ptr__; };                 \
+    (void)_exception_code; (void)_exception_info;                                       \
+    (__VA_ARGS__); }))
+#define __assume(x) ((void)0)
+#else
+#define __seh_try __try
+#define __endtry
+#endif
+
 // MSVC debugger annotations (no code is generated for them)
 #define __annotation(...) ((void)0)
 
@@ -17,8 +51,16 @@
 
 // windows.h defines min/max as macros (unless NOMINMAX); mingw-w64 only does so
 // for C. The Windows code of CoreCLR relies on them in C++ too. (libc++ saves and
-// undefines them around its own min/max.)
-#ifndef NOMINMAX
+// undefines them around its own min/max.) libstdc++ undefines them (c++config.h)
+// and cannot have them as macros, so with GCC they are functions with the same
+// (a ? b : c) result type.
+#if defined(__cplusplus) && defined(__GNUC__) && !defined(__clang__)
+// (prvalue operands: decltype(a < b ? a : b) is a reference to the parameter)
+template <typename A, typename B>
+constexpr auto max(A a, B b) -> decltype(a > b ? static_cast<A>(a) : static_cast<B>(b)) { return a > b ? a : b; }
+template <typename A, typename B>
+constexpr auto min(A a, B b) -> decltype(a < b ? static_cast<A>(a) : static_cast<B>(b)) { return a < b ? a : b; }
+#elif !defined(NOMINMAX)
 #ifndef max
 #define max(a, b) (((a) > (b)) ? (a) : (b))
 #endif
