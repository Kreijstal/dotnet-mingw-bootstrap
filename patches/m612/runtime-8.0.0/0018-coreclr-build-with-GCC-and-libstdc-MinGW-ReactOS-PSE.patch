diff --git a/src/coreclr/CMakeLists.txt b/src/coreclr/CMakeLists.txt
index 36edfabd3..6dd9d74bd 100644
--- a/src/coreclr/CMakeLists.txt
+++ b/src/coreclr/CMakeLists.txt
@@ -20,25 +20,53 @@ if(CLR_CMAKE_HOST_WIN32 AND MINGW)
   set(CMAKE_ASM_MASM_FLAGS "${CMAKE_ASM_MASM_FLAGS} -win64 -nologo")
   add_compile_definitions($<$<COMPILE_LANGUAGE:ASM_MASM>:__MINGW32__>)
 
-  # The Windows code paths of CoreCLR compiled by clang with the GNU driver
+  # The Windows code paths of CoreCLR compiled with the GNU driver
   # (x86_64-w64-mingw32): the MSVC options of configurecompiler.cmake become
-  # their clang spellings, as on Unix.
-  # __declspec(uuid), __if_exists, __uuidof ... (C++ only: in C it turns the
-  # MSVC intrinsics such as __cpuidex into builtins that need MSVC's intrin.h)
-  add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fms-extensions>)
-  add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>)   # /GR-
-  set(CLR_MINGW_C_CXX_OPTIONS -fwrapv -fno-omit-frame-pointer -ffp-contract=off -ferror-limit=4096
-      -Wno-unused-variable -Wno-unused-value -Wno-unused-function -Wno-tautological-compare
-      -Wno-unknown-pragmas -Wno-unknown-warning-option -Wno-unused-private-field
-      -Wno-constant-logical-operand -Wno-pragma-pack -Wno-incompatible-ms-struct
-      -Wno-reserved-identifier -Wno-unsafe-buffer-usage -Wno-single-bit-bitfield-constant-conversion
-      -Wno-cast-function-type-strict -Wno-unused-but-set-variable -Wno-microsoft
-      -Wno-ignored-attributes -Wno-invalid-noreturn -Wno-nonportable-include-path
-      -Wno-format -Wno-missing-braces -Wno-dll-attribute-on-redeclaration)
-  foreach(opt IN LISTS CLR_MINGW_C_CXX_OPTIONS)
-    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:${opt}>)
-  endforeach()
-  add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-Wno-invalid-offsetof>)
+  # their clang or GCC spellings, as on Unix.
+  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    # __declspec(uuid), __if_exists, __uuidof ... (C++ only: in C it turns the
+    # MSVC intrinsics such as __cpuidex into builtins that need MSVC's intrin.h)
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fms-extensions>)
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>)   # /GR-
+    set(CLR_MINGW_C_CXX_OPTIONS -fwrapv -fno-omit-frame-pointer -ffp-contract=off -ferror-limit=4096
+        -Wno-unused-variable -Wno-unused-value -Wno-unused-function -Wno-tautological-compare
+        -Wno-unknown-pragmas -Wno-unknown-warning-option -Wno-unused-private-field
+        -Wno-constant-logical-operand -Wno-pragma-pack -Wno-incompatible-ms-struct
+        -Wno-reserved-identifier -Wno-unsafe-buffer-usage -Wno-single-bit-bitfield-constant-conversion
+        -Wno-cast-function-type-strict -Wno-unused-but-set-variable -Wno-microsoft
+        -Wno-ignored-attributes -Wno-invalid-noreturn -Wno-nonportable-include-path
+        -Wno-format -Wno-missing-braces -Wno-dll-attribute-on-redeclaration)
+    foreach(opt IN LISTS CLR_MINGW_C_CXX_OPTIONS)
+      add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:${opt}>)
+    endforeach()
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-Wno-invalid-offsetof>)
+  else()
+    # GCC: /EHa is -fnon-call-exceptions (faulting instructions, not only calls,
+    # get EH table entries, so the C++ handlers that minipal/Windows/mingw_eha.cpp
+    # runs for SEH exceptions cover them too); __try/__except/__finally come from
+    # ReactOS's PSEH (pseh2_64.h, CLR_MINGW_PSEH_INCLUDE) and its gcc_plugin_seh
+    # (CLR_MINGW_GCC_SEH_PLUGIN), see inc/mingw/msvc_compat.h; MSVC's anonymous
+    # struct members need -fms-extensions.
+    # The Windows code type-puns as MSVC allows, e.g. cor.h reads a ULONG
+    # (unsigned long) through uint32_t*: -fno-strict-aliasing.
+    if(NOT CLR_MINGW_GCC_SEH_PLUGIN OR NOT CLR_MINGW_PSEH_INCLUDE)
+      message(FATAL_ERROR "GCC needs CLR_MINGW_GCC_SEH_PLUGIN and CLR_MINGW_PSEH_INCLUDE (ReactOS gcc_plugin_seh, PSEH)")
+    endif()
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>)   # /GR-
+    set(CLR_MINGW_C_CXX_OPTIONS -fms-extensions -fwrapv -fno-omit-frame-pointer -ffp-contract=off
+        -fnon-call-exceptions -fno-strict-aliasing -fmax-errors=200
+        -Wno-unused-variable -Wno-unused-value -Wno-unused-function -Wno-unknown-pragmas
+        -Wno-unused-but-set-variable -Wno-attributes -Wno-format -Wno-missing-braces
+        -Wno-multichar -Wno-comment -Wno-parentheses -Wno-sign-compare -Wno-narrowing
+        -Wno-int-to-pointer-cast -Wno-cast-function-type -Wno-unused-local-typedefs)
+    foreach(opt IN LISTS CLR_MINGW_C_CXX_OPTIONS)
+      add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:${opt}>)
+    endforeach()
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-Wno-invalid-offsetof> $<$<COMPILE_LANGUAGE:CXX>:-Wno-class-memaccess>)
+    # (a cc1plus plugin: the C sources have no __try)
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fplugin=${CLR_MINGW_GCC_SEH_PLUGIN}>)
+    include_directories(AFTER ${CLR_MINGW_PSEH_INCLUDE})
+  endif()
   # The clr_std headers stand in for the C++ library only where there is none
   # (Unix, -nostdinc); with libc++ present they would clash with it.
   add_compile_definitions(USE_STL)
