 src/coreclr/debug/ee/controller.cpp   |  2 +-
 src/coreclr/gc/gc.cpp                 |  2 +-
 src/coreclr/ilasm/CMakeLists.txt      |  7 +++
 src/coreclr/ildasm/exe/CMakeLists.txt |  6 +++
 src/coreclr/inc/mingw/msvc_compat.h   | 54 +++++++++++++++++++---
 src/coreclr/inc/palclr.h              | 10 +++--
 src/coreclr/inc/palclr_win.h          |  7 +--
 src/coreclr/inc/utilcode.h            | 21 +++++++++
 src/coreclr/jit/jittelemetry.cpp      |  3 +-
 src/coreclr/utilcode/stacktrace.cpp   |  3 +-
 src/coreclr/vm/assembly.cpp           |  2 +-
