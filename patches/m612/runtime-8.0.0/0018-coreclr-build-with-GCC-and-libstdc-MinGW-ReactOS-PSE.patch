diff --git a/src/coreclr/vm/comcache.cpp b/src/coreclr/vm/comcache.cpp
index 573ead1a9..92b3d4b05 100644
--- a/src/coreclr/vm/comcache.cpp
+++ b/src/coreclr/vm/comcache.cpp
@@ -10,6 +10,14 @@
 #include "runtimecallablewrapper.h"
 #include <mtx.h>
 
+#if defined(__GNUC__) && !defined(__clang__)
+// mingw-w64's libuuid.a has this CLSID in one member with thousands of other
+// GUIDs, including the transaction IIDs that <mtx.h> defines (selectany) in the
+// files where eventtracebase.h left INITGUID on; GNU ld rejects such pairs. So
+// define it here (selectany too) rather than pull in that member.
+DEFINE_GUID(CLSID_InProcFreeMarshaler, 0x0000033a, 0, 0, 0xc0, 0, 0, 0, 0, 0, 0, 0x46);
+#endif
+
 #ifdef FEATURE_COMINTEROP_APARTMENT_SUPPORT
