--- /dev/null
+++ b/src/coreclr/inc/mingw/winnt.h
@@ -0,0 +1,64 @@
+// MinGW: wraps mingw-w64's winnt.h for the Windows code of CoreCLR.
+//
+// - C_ASSERT: mingw-w64's is an extern declaration (MSVC's is a typedef), which
+//   is not allowed at class scope, where CoreCLR uses it; in C++ it becomes a
+//   static_assert, as in the PAL.
+// - KNONVOLATILE_CONTEXT_POINTERS (x64): mingw-w64 only has the two arrays
+//   FloatingContext[16]/IntegerContext[16]; the Windows SDK overlays them with the
+//   named members Xmm0..Xmm15 and Rax..R15, which CoreCLR uses. Rename mingw's
+//   definition and provide the SDK's (same layout).
+
+#if defined(__x86_64__)
+#define _KNONVOLATILE_CONTEXT_POINTERS _MINGW_KNONVOLATILE_CONTEXT_POINTERS
+#define KNONVOLATILE_CONTEXT_POINTERS MINGW_KNONVOLATILE_CONTEXT_POINTERS
+#define PKNONVOLATILE_CONTEXT_POINTERS PMINGW_KNONVOLATILE_CONTEXT_POINTERS
+#endif
+
+#include_next <winnt.h>
+
+// A ReplacesCorHdrNumericDefines constant missing from mingw-w64's winnt.h (code
+// that includes only corhdr.h, e.g. jitinterface, gets corhdr's own enum).
+#ifndef COMIMAGE_FLAGS_NATIVE_ENTRYPOINT
+#define COMIMAGE_FLAGS_NATIVE_ENTRYPOINT 0x00000010
+#endif
+#ifndef COMIMAGE_FLAGS_32BITPREFERRED
+#define COMIMAGE_FLAGS_32BITPREFERRED 0x00020000
+#endif
+#ifndef COR_VTABLE_FROM_UNMANAGED_RETAIN_APPDOMAIN
+#define COR_VTABLE_FROM_UNMANAGED_RETAIN_APPDOMAIN 0x08
+#endif
+
+#if defined(__x86_64__)
+#undef _KNONVOLATILE_CONTEXT_POINTERS
+#undef KNONVOLATILE_CONTEXT_POINTERS
+#undef PKNONVOLATILE_CONTEXT_POINTERS
+#if !defined(CLR_MINGW_KNONVOLATILE_CONTEXT_POINTERS)
+#define CLR_MINGW_KNONVOLATILE_CONTEXT_POINTERS
+typedef struct _KNONVOLATILE_CONTEXT_POINTERS {
+    union {
+        PM128A FloatingContext[16];
+        struct {
+            PM128A Xmm0, Xmm1, Xmm2, Xmm3, Xmm4, Xmm5, Xmm6, Xmm7,
+                   Xmm8, Xmm9, Xmm10, Xmm11, Xmm12, Xmm13, Xmm14, Xmm15;
+        };
+    };
+    union {
+        PDWORD64 IntegerContext[16];
+        struct {
+            PDWORD64 Rax, Rcx, Rdx, Rbx, Rsp, Rbp, Rsi, Rdi,
+                     R8, R9, R10, R11, R12, R13, R14, R15;
+        };
+    };
+} KNONVOLATILE_CONTEXT_POINTERS, *PKNONVOLATILE_CONTEXT_POINTERS;
+#ifdef __cplusplus
+static_assert(sizeof(KNONVOLATILE_CONTEXT_POINTERS) == sizeof(MINGW_KNONVOLATILE_CONTEXT_POINTERS), "layout");
+#endif
+// (the OS's RtlVirtualUnwind is declared with PMINGW_KNONVOLATILE_CONTEXT_POINTERS;
+// CoreCLR calls it through RtlVirtualUnwind_Unsafe, typed with this struct)
+#endif
+#endif
+
+#if defined(__cplusplus)
+#undef C_ASSERT
+#define C_ASSERT(e) static_assert(e, #e)
+#endif
