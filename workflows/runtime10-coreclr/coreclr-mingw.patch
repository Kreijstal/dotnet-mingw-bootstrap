 // when these macros are used from within the VM.
 #define PAL_SEH_RESTORE_GUARD_PAGE
 
+// clang (LLVM 22, x86-64 SEH) miscompiles a __finally block -- the outlined funclet and
+// its inlined copy on the normal path -- that accesses a parent-frame local at a nonzero
+// offset (a member of a local struct): the frame-escape offset of llvm.localrecover is
+// dropped and only the member offset is added to the frame pointer, so the access hits
+// the saved registers instead. Functions containing such __finally blocks are compiled
+// without optimization (the bug needs it); see SEH_FINALLY_FUNCTION users.
+#if defined(__clang__) && defined(__MINGW32__)
+#define SEH_FINALLY_FUNCTION __attribute__((optnone, noinline))
+#else
+#define SEH_FINALLY_FUNCTION
+#endif
