+//
+// /EHa semantics for CoreCLR built by clang for x86_64-w64-mingw32.
+//
+// CoreCLR's Windows code is written for MSVC's /EHa: C++ destructors run when
+// *any* SEH exception (an access violation, a managed exception raised as
+// EXCEPTION_COMPLUS, ...) unwinds a frame, and catch(...) (EX_CATCH) catches SEH
+// exceptions. With MinGW, C++ uses the Itanium EH model on top of SEH
+// (libc++abi's __gxx_personality_seh0 over libunwind's _GCC_specific_handler),
+// which deliberately ignores foreign (non-C++) exceptions: no destructor runs and
+// no catch(...) matches. This file adds the /EHa behavior:
+//
+//  * __gxx_personality_seh0 (wrapped with lld --wrap): for a foreign exception,
+//    phase 1 looks for a catch(...) clause covering the frame's PC in the LSDA;
+//    if there is one, the exception is wrapped into a C++ exception object of
+//    type EhaSehException and the stack is unwound to that catch(...) landing pad
+//    (RtlUnwindEx), as MSVC does. In phase 2 (an unwind passing through), the
+//    frame's cleanup landing pad (destructors) is entered with a collided unwind;
+//    when it calls _Unwind_Resume, the original unwind is restarted.
+//  * _Unwind_Resume (wrapped): restarts the unwind a cleanup landing pad
+//    interrupted, for unwinds this file knows about.
+//  * __C_specific_handler (wrapped): the __try/__except/__finally handler, as
+//    Windows' own, except that it records the unwinds it starts (an __except
+//    catching an exception), so that C++ frames in between get their
+//    destructors run and the unwind can be resumed after them.
+//  * __cxa_rethrow (wrapped): "throw;" inside catch(...) of an SEH exception
+//    raises the SEH exception again (MSVC semantics), instead of a C++ exception.
+//  * CLR_MinGW_RtlUnwind: used by CoreCLR's managed exception handling instead of
+//    RtlUnwind, so that its unwinds can be resumed too.
+//
+// An unwind can only be resumed after a landing pad if its target frame, target
+// IP and return value are known, which is why the unwinds are started through
+// these functions and described by an EhaUnwind record. The EXCEPTION_RECORD
+// handed to RtlUnwindEx is a copy inside that record (the original lives on the
+// stack of the exception dispatcher, which a landing pad overwrites), tagged so
+// that every handler, also those of another module (clrjit.dll), can find it.
+// Unwinds started elsewhere (e.g. by an __except in system code) unwind C++ frames
+// without running their destructors, as before; set CLR_MINGW_EHA_TRACE=1 to log them.
+//
+// Limitation: clang (without -fasync-exceptions, which it cannot combine with the
+// Itanium C++ ABI) only records call sites in the LSDA and in __try ranges, so a
+// hardware fault raised by a non-call instruction of a C++ function or a __try
+// block is attributed to no handler of that function.
+//
+
+#if defined(__MINGW32__) && defined(__x86_64__)
+
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unwind.h>
+#include <typeinfo>
+#include <new>
+
+#define STATUS_GCC_THROW  0x20474343   // libunwind: C++ throw (phase 1, and phase 2 started by libunwind)
+#define STATUS_GCC_UNWIND 0x21474343   // libunwind: collided unwind to a landing pad
+
+#ifndef EXCEPTION_UNWINDING
+#define EXCEPTION_UNWINDING 0x2
+#endif
+#ifndef EXCEPTION_EXIT_UNWIND
+#define EXCEPTION_EXIT_UNWIND 0x4
+#endif
+#ifndef EXCEPTION_TARGET_UNWIND
+#define EXCEPTION_TARGET_UNWIND 0x20
+#endif
+#define EHA_IS_UNWINDING(flags) (((flags) & (EXCEPTION_UNWINDING | EXCEPTION_EXIT_UNWIND)) != 0)
+
+extern "C" {
+// the wrapped implementations (lld --wrap)
+EXCEPTION_DISPOSITION __real___gxx_personality_seh0(PEXCEPTION_RECORD, void*, PCONTEXT, PDISPATCHER_CONTEXT);
+void __real__Unwind_Resume(_Unwind_Exception*);
+void __real___cxa_rethrow();
+
+// libc++abi
+void* __cxa_allocate_exception(size_t) noexcept;
+void* __cxa_init_primary_exception(void* object, std::type_info* tinfo, void (*dest)(void*)) noexcept;
+void __cxa_increment_exception_refcount(void*) noexcept;
+void __cxa_decrement_exception_refcount(void*) noexcept;
+std::type_info* __cxa_current_exception_type() noexcept;
+void* __cxa_current_primary_exception() noexcept;
+void* __cxa_get_globals() noexcept;
+}
