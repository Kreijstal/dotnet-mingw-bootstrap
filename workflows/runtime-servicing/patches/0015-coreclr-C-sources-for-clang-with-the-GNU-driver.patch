     void * pf = &__security_check_cookie;
     pf = NULL;
 
     GSCookie val = (GSCookie)(__security_cookie ^ GetTickCount());
+#endif
 #else // !TARGET_UNIX
     // REVIEW: Need something better for PAL...
     GSCookie val = (GSCookie)GetTickCount();
