From 97701ce93b66afa3b6ab992a4bea9a03dd1da901 Mon Sep 17 00:00:00 2001
From: Kreijstal <elektrischrainbow@gmail.com>
Date: Fri, 9 Oct 2026 17:26:09 +0200
Subject: [PATCH 14/16] coreclr: amd64 MASM helpers for UASM and the Itanium
 C++ ABI

- .errnz/.erre messages in <> (UASM takes a single token otherwise).
- NOP_3_BYTE, rdsspq/incsspq and the REX.W prefix of JIT_DispatchIndirect-
  Call as bytes; ALTENTRY as a public label for UASM.
- With __MINGW32__, the C++ symbols the stubs use by their MSVC-mangled
  names get their Itanium names (InlinedCallFrame's vtable address point
  is _ZTV16InlinedCallFrame+16; the redirect targets' names are built
  with @CatStr/@SizeStr).
---
 src/coreclr/vm/amd64/AsmMacros.inc            | 25 ++++++-----
 src/coreclr/vm/amd64/Context.asm              |  6 ++-
 src/coreclr/vm/amd64/JitHelpers_Fast.asm      | 12 +++++-
 .../vm/amd64/JitHelpers_InlineGetThread.asm   | 24 +++++++++++
 src/coreclr/vm/amd64/JitHelpers_Slow.asm      | 32 +++++++++++++++
 src/coreclr/vm/amd64/PInvokeStubs.asm         | 10 +++++
 .../vm/amd64/RedirectedHandledJITCase.asm     | 41 +++++++++++++++----
 src/coreclr/vm/amd64/VirtualCallStubAMD64.asm |  4 ++
 8 files changed, 134 insertions(+), 20 deletions(-)

diff --git a/src/coreclr/vm/amd64/AsmMacros.inc b/src/coreclr/vm/amd64/AsmMacros.inc
index 2d14b9c31..4ee1696b6 100644
--- a/src/coreclr/vm/amd64/AsmMacros.inc
+++ b/src/coreclr/vm/amd64/AsmMacros.inc
@@ -16,7 +16,7 @@ push_nonvol_reg macro Reg
 
 push_vol_reg macro Reg
 
-        .errnz ___STACK_ADJUSTMENT_FORBIDDEN, push_vol_reg cannot be used after save_reg_postrsp
+        .errnz ___STACK_ADJUSTMENT_FORBIDDEN, <push_vol_reg cannot be used after save_reg_postrsp>
 
         push    Reg
         .allocstack 8
@@ -25,7 +25,7 @@ push_vol_reg macro Reg
 
 push_eflags macro
 
-        .errnz ___STACK_ADJUSTMENT_FORBIDDEN, push_eflags cannot be used after save_reg_postrsp
+        .errnz ___STACK_ADJUSTMENT_FORBIDDEN, <push_eflags cannot be used after save_reg_postrsp>
 
         pushfq
         .allocstack 8
@@ -34,7 +34,7 @@ push_eflags macro
 
 alloc_stack macro Size
 
-        .errnz ___STACK_ADJUSTMENT_FORBIDDEN, alloc_stack cannot be used after save_reg_postrsp
+        .errnz ___STACK_ADJUSTMENT_FORBIDDEN, <alloc_stack cannot be used after save_reg_postrsp>
 
         sub     rsp, Size
         .allocstack Size
@@ -43,7 +43,7 @@ alloc_stack macro Size
 
 save_reg_frame macro Reg, FrameReg, Offset
 
-        .erre ___FRAME_REG_SET, save_reg_frame cannot be used before set_frame
+        .erre ___FRAME_REG_SET, <save_reg_frame cannot be used before set_frame>
 
         mov     Offset[FrameReg], Reg
         .savereg Reg, Offset
@@ -52,7 +52,7 @@ save_reg_frame macro Reg, FrameReg, Offset
 
 save_reg_postrsp macro Reg, Offset
 
-        .errnz ___FRAME_REG_SET, save_reg_postrsp cannot be used after set_frame
+        .errnz ___FRAME_REG_SET, <save_reg_postrsp cannot be used after set_frame>
 
         mov     Offset[rsp], Reg
         .savereg Reg, Offset
@@ -63,7 +63,7 @@ save_reg_postrsp macro Reg, Offset
 
 save_xmm128_frame macro Reg, FrameReg, Offset
 
-        .erre ___FRAME_REG_SET, save_xmm128_frame cannot be used before set_frame
+        .erre ___FRAME_REG_SET, <save_xmm128_frame cannot be used before set_frame>
 
         movdqa  Offset[FrameReg], Reg
         .savexmm128 Reg, Offset
@@ -72,7 +72,7 @@ save_xmm128_frame macro Reg, FrameReg, Offset
 
 save_xmm128_postrsp macro Reg, Offset
 
-        .errnz ___FRAME_REG_SET, save_reg_postrsp cannot be used after set_frame
+        .errnz ___FRAME_REG_SET, <save_reg_postrsp cannot be used after set_frame>
 
         movdqa  Offset[rsp], Reg
         .savexmm128 Reg, Offset
@@ -83,7 +83,7 @@ save_xmm128_postrsp macro Reg, Offset
 
 set_frame macro Reg, Offset
 
-        .errnz ___FRAME_REG_SET, set_frame cannot be used more than once
+        .errnz ___FRAME_REG_SET, <set_frame cannot be used more than once>
 
 if Offset
 
@@ -191,7 +191,11 @@ Section ends
 ; Inlined version of GetThread
 ; Trashes rax and r11
 ;
+ifdef __MINGW32__
+; (gCurrentThreadInfo: same name without C++ mangling)
+else
 gCurrentThreadInfo  TEXTEQU <?gCurrentThreadInfo@@3UThreadLocalInfo@@A>
+endif
 
 INLINE_GETTHREAD macro Reg
 
@@ -253,7 +257,8 @@ NOP_2_BYTE macro
 
 NOP_3_BYTE macro
 
-        nop dword ptr [rax]
+        ; nop dword ptr [rax], spelled as bytes for assemblers without multi-byte nop
+        db 0Fh, 1Fh, 00h
 
         endm
 
@@ -373,7 +378,7 @@ PROLOG_WITH_TRANSITION_BLOCK macro extraLocals := <0>, stackAllocOnEntry := <0>,
         __PWTB_TransitionBlock = __PWTB_StackAlloc
         __PWTB_ArgumentRegisters = __PWTB_StackAlloc + 9 * 8
 
-        .errnz stackAllocOnEntry ge 4*8, Max supported stackAllocOnEntry is 3*8
+        .errnz stackAllocOnEntry ge 4*8, <Max supported stackAllocOnEntry is 3*8>
 
         if stackAllocOnEntry gt 0
         .allocstack stackAllocOnEntry
diff --git a/src/coreclr/vm/amd64/Context.asm b/src/coreclr/vm/amd64/Context.asm
index 71bc2566f..50c5e9929 100644
--- a/src/coreclr/vm/amd64/Context.asm
+++ b/src/coreclr/vm/amd64/Context.asm
@@ -43,10 +43,12 @@ NESTED_ENTRY ClrRestoreNonvolatileContextWorker, _TEXT
 
         test    rdx, rdx
         je      No_Ssp_Update
-        rdsspq  rax
+        ; rdsspq rax (as bytes: not every MASM-compatible assembler knows the CET instructions)
+        db 0F3h, 48h, 0Fh, 1Eh, 0C8h
         sub     rdx, rax
         shr     rdx, 3
-        incsspq rdx
+        ; incsspq rdx
+        db 0F3h, 48h, 0Fh, 0AEh, 0EAh
     No_Ssp_Update:
 
         ; When user-mode shadow stacks are enabled, and for example the intent is to continue execution in managed code after
diff --git a/src/coreclr/vm/amd64/JitHelpers_Fast.asm b/src/coreclr/vm/amd64/JitHelpers_Fast.asm
index dd5b891a4..14f12b55c 100644
--- a/src/coreclr/vm/amd64/JitHelpers_Fast.asm
+++ b/src/coreclr/vm/amd64/JitHelpers_Fast.asm
@@ -35,8 +35,16 @@ endif
 
 ifdef WRITE_BARRIER_CHECK
 ; Those global variables are always defined, but should be 0 for Server GC
+ifdef __MINGW32__
+; (g_GCShadow: same name without C++ mangling)
+else
 g_GCShadow                      TEXTEQU <?g_GCShadow@@3PEAEEA>
+endif
+ifdef __MINGW32__
+; (g_GCShadowEnd: same name without C++ mangling)
+else
 g_GCShadowEnd                   TEXTEQU <?g_GCShadowEnd@@3PEAEEA>
+endif
 EXTERN  g_GCShadow:QWORD
 EXTERN  g_GCShadowEnd:QWORD
 endif
@@ -525,7 +533,9 @@ ifdef _DEBUG
         mov r10, 0CDCDCDCDCDCDCDCDh ; The real helper clobbers these registers, so clobber them too in the fake helper
         mov r11, 0CDCDCDCDCDCDCDCDh
 endif
-        rexw jmp rax
+        ; rexw jmp rax (REX.W prefix as a byte for assemblers without "rexw")
+        db 48h
+        jmp rax
 LEAF_END JIT_DispatchIndirectCall, _TEXT
 
 
diff --git a/src/coreclr/vm/amd64/JitHelpers_InlineGetThread.asm b/src/coreclr/vm/amd64/JitHelpers_InlineGetThread.asm
index bf79668e5..17c0ce425 100644
--- a/src/coreclr/vm/amd64/JitHelpers_InlineGetThread.asm
+++ b/src/coreclr/vm/amd64/JitHelpers_InlineGetThread.asm
@@ -15,12 +15,36 @@ include asmconstants.inc
 ; Min amount of stack space that a nested function should allocate.
 MIN_SIZE equ 28h
 
+ifdef __MINGW32__
+JIT_NEW                 equ     _Z7JIT_NewP21CORINFO_CLASS_STRUCT_
+else
 JIT_NEW                 equ     ?JIT_New@@YAPEAVObject@@PEAUCORINFO_CLASS_STRUCT_@@@Z
+endif
+ifdef __MINGW32__
+CopyValueClassUnchecked equ     _Z23CopyValueClassUncheckedPvS_P11MethodTable
+else
 CopyValueClassUnchecked equ     ?CopyValueClassUnchecked@@YAXPEAX0PEAVMethodTable@@@Z
+endif
+ifdef __MINGW32__
+JIT_Box                 equ     _Z7JIT_BoxP21CORINFO_CLASS_STRUCT_Pv
+else
 JIT_Box                 equ     ?JIT_Box@@YAPEAVObject@@PEAUCORINFO_CLASS_STRUCT_@@PEAX@Z
+endif
+ifdef __MINGW32__
+; (g_pStringClass: same name without C++ mangling)
+else
 g_pStringClass          equ     ?g_pStringClass@@3PEAVMethodTable@@EA
+endif
+ifdef __MINGW32__
+FramedAllocateString    equ     _Z20FramedAllocateStringm
+else
 FramedAllocateString    equ     ?FramedAllocateString@@YAPEAVStringObject@@K@Z
+endif
+ifdef __MINGW32__
+JIT_NewArr1             equ     _Z11JIT_NewArr1P21CORINFO_CLASS_STRUCT_x
+else
 JIT_NewArr1             equ     ?JIT_NewArr1@@YAPEAVObject@@PEAUCORINFO_CLASS_STRUCT_@@_J@Z
+endif
 
 INVALIDGCVALUE          equ     0CCCCCCCDh
 
