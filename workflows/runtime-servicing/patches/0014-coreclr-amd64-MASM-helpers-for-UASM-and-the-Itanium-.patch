diff --git a/src/coreclr/vm/amd64/PInvokeStubs.asm b/src/coreclr/vm/amd64/PInvokeStubs.asm
index 4f19cb7d0..4e774e0d4 100644
--- a/src/coreclr/vm/amd64/PInvokeStubs.asm
+++ b/src/coreclr/vm/amd64/PInvokeStubs.asm
@@ -9,7 +9,13 @@ extern VarargPInvokeStubWorker:proc
 extern JIT_PInvokeEndRarePath:proc
 
 extern s_gsCookie:QWORD
+ifdef __MINGW32__
+; Itanium ABI: the vtable symbol starts with offset-to-top and the RTTI pointer;
+; an object's vptr is the address point 16 bytes in.
+extern _ZTV16InlinedCallFrame:QWORD
+else
 extern ??_7InlinedCallFrame@@6B@:QWORD
+endif
 extern g_TrapReturningThreads:DWORD
 
 ;
@@ -146,7 +152,11 @@ LEAF_ENTRY JIT_PInvokeBegin, _TEXT
         add             rcx, SIZEOF_GSCookie
 
         ;; set first slot to the value of InlinedCallFrame::`vftable' (checked by runtime code)
+ifdef __MINGW32__
+        lea             rax,[_ZTV16InlinedCallFrame + 10h]
+else
         lea             rax,[??_7InlinedCallFrame@@6B@]
+endif
         mov             qword ptr [rcx], rax
 
         mov             qword ptr [rcx + OFFSETOF__InlinedCallFrame__m_Datum], 0
diff --git a/src/coreclr/vm/amd64/RedirectedHandledJITCase.asm b/src/coreclr/vm/amd64/RedirectedHandledJITCase.asm
index 61146cc6f..eabd9628a 100644
--- a/src/coreclr/vm/amd64/RedirectedHandledJITCase.asm
+++ b/src/coreclr/vm/amd64/RedirectedHandledJITCase.asm
@@ -4,7 +4,11 @@
 include AsmMacros.inc
 include asmconstants.inc
 
+ifdef __MINGW32__
+Thread__GetAbortContext equ _ZN6Thread15GetAbortContextEv
+else
 Thread__GetAbortContext equ ?GetAbortContext@Thread@@QEAAPEAU_CONTEXT@@XZ
+endif
 
 extern GetCurrentSavedRedirectContext:proc
 extern Thread__GetAbortContext:proc
@@ -27,7 +31,13 @@ extern FixRedirectContextHandler:proc
 ; This function is used by both the personality routine and the debugger to retrieve the original CONTEXT.
 GenerateRedirectedHandledJITCaseStub macro reason
 
-extern ?RedirectedHandledJITCaseFor&reason&@Thread@@CAXXZ:proc
+ifdef __MINGW32__
+; Itanium name of Thread::RedirectedHandledJITCaseFor<reason>(): _ZN6Thread<length>...Ev
+RedirectTarget TEXTEQU @CatStr(<_ZN6Thread>, %(27 + @SizeStr(reason)), <RedirectedHandledJITCaseFor>, <reason>, <Ev>)
+else
+RedirectTarget TEXTEQU <?RedirectedHandledJITCaseFor&reason&@Thread@@CAXXZ>
+endif
+extern RedirectTarget:proc
 
 NESTED_ENTRY RedirectedHandledJITCaseFor&reason&_Stub, _TEXT, FixRedirectContextHandler
 
@@ -45,7 +55,7 @@ NESTED_ENTRY RedirectedHandledJITCaseFor&reason&_Stub, _TEXT, FixRedirectContext
         alloc_stack     28h                     ; CONTEXT*, callee scratch area
         set_frame       rbp, 0
 
-.errnz REDIRECTSTUB_ESTABLISHER_OFFSET_RBP, REDIRECTSTUB_ESTABLISHER_OFFSET_RBP has changed - update asm stubs
+.errnz REDIRECTSTUB_ESTABLISHER_OFFSET_RBP, <REDIRECTSTUB_ESTABLISHER_OFFSET_RBP has changed - update asm stubs>
 
         END_PROLOGUE
 
@@ -62,7 +72,7 @@ NESTED_ENTRY RedirectedHandledJITCaseFor&reason&_Stub, _TEXT, FixRedirectContext
         call            GetCurrentSavedRedirectContext
 
         mov             [rbp+20h], rax
-.errnz REDIRECTSTUB_RBP_OFFSET_CONTEXT - 20h, REDIRECTSTUB_RBP_OFFSET_CONTEXT has changed - update asm stubs
+.errnz REDIRECTSTUB_RBP_OFFSET_CONTEXT - 20h, <REDIRECTSTUB_RBP_OFFSET_CONTEXT has changed - update asm stubs>
 
         ;
         ; Fetch the interrupted rip and save it as our return address.
@@ -74,7 +84,7 @@ NESTED_ENTRY RedirectedHandledJITCaseFor&reason&_Stub, _TEXT, FixRedirectContext
         ; Call target, which will do whatever we needed to do in the context
         ; of the target thread, and will RtlRestoreContext when it is done.
         ;
-        call            ?RedirectedHandledJITCaseFor&reason&@Thread@@CAXXZ
+        call            RedirectTarget
 
         int             3                       ; target shouldn't return.
 
@@ -105,7 +115,12 @@ SIZEOF__FaultingExceptionFrame = SIZEOF__FaultingExceptionFrame
 
 GenerateRedirectedStubWithFrame macro STUB, FILTER, TARGET
 
+ifdef __UASM__
+; UASM has no ALTENTRY; the label is inside the NESTED_ENTRY below and covered by its unwind info
+public STUB&_RspAligned
+else
 altentry STUB&_RspAligned
+endif
 
 NESTED_ENTRY STUB, _TEXT, FILTER
 
@@ -122,7 +137,11 @@ NESTED_ENTRY STUB, _TEXT, FILTER
         test            rsp, 0fh
         jnz             STUB&_FixRsp
 
+ifdef __UASM__
+STUB&_RspAligned::
+else
 STUB&_RspAligned:
+endif
 
         ; Any stack operations hereafter must be recorded in the unwind info, but
         ; only nonvolatile register locations are needed.  Anything else is only
@@ -133,7 +152,7 @@ STUB&_RspAligned:
 
         alloc_stack     OFFSET_OF_FRAME + SIZEOF__FaultingExceptionFrame
 
-.errnz THROWSTUB_ESTABLISHER_OFFSET_FaultingExceptionFrame - OFFSET_OF_FRAME, THROWSTUB_ESTABLISHER_OFFSET_FaultingExceptionFrame has changed - update asm stubs
+.errnz THROWSTUB_ESTABLISHER_OFFSET_FaultingExceptionFrame - OFFSET_OF_FRAME, <THROWSTUB_ESTABLISHER_OFFSET_FaultingExceptionFrame has changed - update asm stubs>
 
         END_PROLOGUE
 
@@ -206,7 +225,11 @@ GenerateRedirectedStubWithFrame RedirectForThrowControl, HijackHandler, Redirect
 
 ifdef FEATURE_SPECIAL_USER_MODE_APC
 
+ifdef __MINGW32__
+extern _ZN6Thread21ApcActivationCallbackEy:proc
+else
 extern ?ApcActivationCallback@Thread@@CAX_K@Z:proc
+endif
 
 ; extern "C" void NTAPI ApcActivationCallbackStub(ULONG_PTR Parameter);
 NESTED_ENTRY ApcActivationCallbackStub, _TEXT, FixRedirectContextHandler
@@ -214,15 +237,19 @@ NESTED_ENTRY ApcActivationCallbackStub, _TEXT, FixRedirectContextHandler
         push_nonvol_reg rbp
         alloc_stack     30h ; padding for alignment, CONTEXT *, callee scratch area
         set_frame       rbp, 0
-    .errnz REDIRECTSTUB_ESTABLISHER_OFFSET_RBP, REDIRECTSTUB_ESTABLISHER_OFFSET_RBP has changed - update asm stubs
+    .errnz REDIRECTSTUB_ESTABLISHER_OFFSET_RBP, <REDIRECTSTUB_ESTABLISHER_OFFSET_RBP has changed - update asm stubs>
         END_PROLOGUE
 
         ; Save the pointer to the interrupted context on the stack for the stack walker
         mov             rax, [rcx + OFFSETOF__APC_CALLBACK_DATA__ContextRecord]
         mov             [rbp + 20h], rax
-    .errnz REDIRECTSTUB_RBP_OFFSET_CONTEXT - 20h, REDIRECTSTUB_RBP_OFFSET_CONTEXT has changed - update asm stubs
+    .errnz REDIRECTSTUB_RBP_OFFSET_CONTEXT - 20h, <REDIRECTSTUB_RBP_OFFSET_CONTEXT has changed - update asm stubs>
 
+ifdef __MINGW32__
+        call            _ZN6Thread21ApcActivationCallbackEy
+else
         call            ?ApcActivationCallback@Thread@@CAX_K@Z
+endif
 
         add             rsp, 30h
         pop             rbp
