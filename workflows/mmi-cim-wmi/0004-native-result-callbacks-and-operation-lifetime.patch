+// Copyright (c) Microsoft Corporation and MSYS2 port contributors.
+// Licensed under the MIT license; see LICENSE.
+using System;
+using System.Runtime.InteropServices;
+using System.Threading;
+using Microsoft.Management.Infrastructure.Internal;
+
+namespace Microsoft.Management.Infrastructure.Native
+{
+    // Own native callback storage and managed delegate roots until MI_Operation_Close
+    // has returned. The native ABI uses raw pointers and one-byte MI_Boolean.
+    internal sealed class MI_OperationCallbackBridge : IDisposable
+    {
+        private readonly MI_Operation owner;
+        private readonly MI_OperationCallbacks callbacks;
+        private readonly Delegate resultDelegate;
+        private GCHandle root;
+        internal IntPtr Pointer { get; private set; }
+        internal static int ActiveCount;
+        internal static int CleanupFailures;
+
+        [UnmanagedFunctionPointer(MI_PlatformSpecific.MiCallConvention)]
+        private delegate void InstanceCallback(IntPtr operation, IntPtr context, IntPtr instance,
+            byte moreResults, MI_Result result, IntPtr message, IntPtr error, IntPtr acknowledgement);
+        [UnmanagedFunctionPointer(MI_PlatformSpecific.MiCallConvention)]
+        private delegate void IndicationCallback(IntPtr operation, IntPtr context, IntPtr instance,
+            IntPtr bookmark, IntPtr machine, byte moreResults, MI_Result result,
+            IntPtr message, IntPtr error, IntPtr acknowledgement);
+        [UnmanagedFunctionPointer(MI_PlatformSpecific.MiCallConvention)]
+        private delegate MI_Result Acknowledge(IntPtr operation);
+
+        internal MI_OperationCallbackBridge(MI_Operation owner, MI_OperationCallbacks callbacks)
+        {
+            if (callbacks.promptUser != null || callbacks.writeError != null || callbacks.writeMessage != null ||
+                callbacks.writeProgress != null || callbacks.streamedParameterResult != null)
+                throw new NotSupportedException("Extended MI semantics and streamed parameters are not yet ported.");
+            this.owner = owner;
+            this.callbacks = callbacks;
+            int slot;
+            if (callbacks.instanceResult != null)
+            {
+                resultDelegate = new InstanceCallback(InstanceResult);
+                slot = 5;
+            }
+            else if (callbacks.classResult != null)
+            {
+                resultDelegate = new InstanceCallback(ClassResult);
+                slot = 7;
+            }
+            else if (callbacks.indicationResult != null)
+            {
+                resultDelegate = new IndicationCallback(IndicationResult);
+                slot = 6;
+            }
+            else throw new NotSupportedException("An asynchronous MI result callback is required.");
+            Pointer = Marshal.AllocHGlobal(IntPtr.Size * 9);
+            for (int i = 0; i < 9; i++) Marshal.WriteIntPtr(Pointer, i * IntPtr.Size, IntPtr.Zero);
+            Marshal.WriteIntPtr(Pointer, slot * IntPtr.Size, Marshal.GetFunctionPointerForDelegate(resultDelegate));
+            root = GCHandle.Alloc(this);
+            Interlocked.Increment(ref ActiveCount);
+        }
+
+        private void Invoke(IntPtr operation, IntPtr acknowledgement, Action<CimOperationCallbackProcessingContext> action)
+        {
+            var context = new CimOperationCallbackProcessingContext(callbacks.ManagedOperationContext);
+            try { action(context); }
+            catch (Exception error)
+            {
+                // A managed exception must never unwind through an unmanaged callback.
+                try { callbacks.InternalErrorCallback?.Invoke(context, error); } catch { }
+            }
+            finally
+            {
+                if (acknowledgement != IntPtr.Zero)
+                    Marshal.GetDelegateForFunctionPointer<Acknowledge>(acknowledgement)(operation);
+                GC.KeepAlive(this);
+            }
+        }
+
+        private static MI_Instance Instance(IntPtr pointer) => pointer == IntPtr.Zero ? null : MI_Instance.NewFromDirectPtr(pointer);
+        private static MI_Class Class(IntPtr pointer) => pointer == IntPtr.Zero ? null : MI_Class.NewFromDirectPtr(pointer);
+
+        private void InstanceResult(IntPtr operation, IntPtr context, IntPtr instance, byte moreResults,
+            MI_Result result, IntPtr message, IntPtr error, IntPtr acknowledgement)
+        {
+            using (var value = Instance(instance))
+            using (var details = Instance(error))
+                Invoke(operation, acknowledgement, processing => callbacks.instanceResult(owner, processing,
+                    value, moreResults != 0, result, MI_PlatformSpecific.PtrToString(message), details, null));
+        }
+        private void ClassResult(IntPtr operation, IntPtr context, IntPtr cls, byte moreResults,
+            MI_Result result, IntPtr message, IntPtr error, IntPtr acknowledgement)
+        {
+            using (var value = Class(cls))
+            using (var details = Instance(error))
+                Invoke(operation, acknowledgement, processing => callbacks.classResult(owner, processing,
+                    value, moreResults != 0, result, MI_PlatformSpecific.PtrToString(message), details, null));
+        }
+        private void IndicationResult(IntPtr operation, IntPtr context, IntPtr instance, IntPtr bookmark,
+            IntPtr machine, byte moreResults, MI_Result result, IntPtr message, IntPtr error, IntPtr acknowledgement)
+        {
+            using (var value = Instance(instance))
+            using (var details = Instance(error))
+                Invoke(operation, acknowledgement, processing => callbacks.indicationResult(owner, processing,
+                    value, MI_PlatformSpecific.PtrToString(bookmark), MI_PlatformSpecific.PtrToString(machine),
+                    moreResults != 0, result, MI_PlatformSpecific.PtrToString(message), details, null));
+        }
+        public void Dispose()
+        {
+            if (Pointer == IntPtr.Zero) return;
+            Marshal.FreeHGlobal(Pointer);
+            Pointer = IntPtr.Zero;
+            if (root.IsAllocated) root.Free();
+            Interlocked.Decrement(ref ActiveCount);
+        }
+    }
+}
