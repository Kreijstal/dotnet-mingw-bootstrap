// Stand-in for the NativeVersion.rc that the Arcade SDK generates for the
// MSVC build (version resource of the WPF native DLLs).
#include <winver.h>
#include "wpfver.h"

#ifndef FX_VER_FILEDESCRIPTION_STR
#define FX_VER_FILEDESCRIPTION_STR "Windows Presentation Foundation native component"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WPF_VER_MAJOR,WPF_VER_MINOR,WPF_VER_PATCH,0
 PRODUCTVERSION WPF_VER_MAJOR,WPF_VER_MINOR,WPF_VER_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      ".NET Foundation (built with mingw-w64)"
            VALUE "FileDescription",  FX_VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",      WPF_VER_STR
            VALUE "LegalCopyright",   "Licensed under the MIT license"
            VALUE "ProductName",      "Windows Presentation Foundation"
            VALUE "ProductVersion",   WPF_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
