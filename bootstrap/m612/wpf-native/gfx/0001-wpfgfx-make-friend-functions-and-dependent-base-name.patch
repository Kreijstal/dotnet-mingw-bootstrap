From 310c5041c00ab636f025fca5c812892a75e1b339 Mon Sep 17 00:00:00 2001
From: Kreijstal <rainb@tfwno.gf>
Date: Thu, 8 Oct 2026 11:10:55 +0200
Subject: [PATCH 1/6] wpfgfx: make friend functions and dependent-base names
 visible

MSVC finds functions that are only declared as friends by ordinary name
lookup, accepts 'friend static', and looks names up in dependent base
classes from declarations.  Declare the scan-op friends at namespace
scope, drop 'static' from friend declarations, restate CRectF's
BaseMILRectType, make the brush allocators protected so LocalMILObject<>'s
virtual destructor can reach operator delete, and select TRect_'s body with
a trait instead of a class-scope __if_exists (which clang ignores for
dependent names).
---
 .../src/WpfGfx/core/api/api_brush.h           | 10 ++++----
 .../src/WpfGfx/core/common/Rect.h             | 24 +++++++++++++++----
 .../src/WpfGfx/core/hw/d3dswapchainwithswdc.h |  2 +-
 .../src/WpfGfx/core/sw/bilinearspan.h         | 22 +++++++++++++++--
 .../src/WpfGfx/core/sw/brushspan.h            | 10 ++++++++
 .../src/WpfGfx/core/sw/swlib/aarasterizer.cpp | 15 +++++++++++-
 6 files changed, 70 insertions(+), 13 deletions(-)

diff --git a/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/api/api_brush.h b/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/api/api_brush.h
index cfebe4f..2a11447 100644
--- a/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/api/api_brush.h
+++ b/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/api/api_brush.h
@@ -55,7 +55,7 @@ protected:
     CMILBrushSolid(__in_ecount_opt(1) CMILFactory *pFactory = NULL);
     virtual ~CMILBrushSolid();
 
-private:
+protected: // derived LocalMILObject<> needs operator delete for its virtual dtor
     DECLARE_METERHEAP_ALLOC(ProcessHeap, Mt(CMILBrushSolid));
 
 public:
@@ -113,7 +113,7 @@ protected:
     CMILBrushLinearGradient(__in_ecount_opt(1) CMILFactory *pFactory = NULL);
     virtual ~CMILBrushLinearGradient();
 
-private:
+protected: // derived LocalMILObject<> needs operator delete for its virtual dtor
     // Create should be used to instantiate this object, not operator new.
     DECLARE_METERHEAP_ALLOC(ProcessHeap, Mt(CMILBrushLinearGradient));
 
@@ -168,7 +168,7 @@ protected:
     CMILBrushRadialGradient(__in_ecount_opt(1) CMILFactory *pFactory = NULL);
     virtual ~CMILBrushRadialGradient();
 
-private:
+protected: // derived LocalMILObject<> needs operator delete for its virtual dtor
     // Create should be used to instantiate this object, not operator new.
     DECLARE_METERHEAP_ALLOC(ProcessHeap, Mt(CMILBrushRadialGradient));
 
@@ -269,7 +269,7 @@ protected:
     CMILBrushBitmap(OPTIONAL CMILFactory *pFactory = NULL);
     virtual ~CMILBrushBitmap();
 
-private:
+protected: // derived LocalMILObject<> needs operator delete for its virtual dtor
 
     // Create should be used to instantiate this object, not operator new.
     DECLARE_METERHEAP_ALLOC(ProcessHeap, Mt(CMILBrushBitmap));
@@ -517,7 +517,7 @@ protected:
     CMILBrushShaderEffect(__in CMilEffectDuce *pShaderEffect);
     ~CMILBrushShaderEffect() override;
 
-private:
+protected: // derived LocalMILObject<> needs operator delete for its virtual dtor
     DECLARE_METERHEAP_ALLOC(ProcessHeap, Mt(CMILBrushShaderEffect));
 
 public:
diff --git a/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/common/Rect.h b/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/common/Rect.h
index d7af860..df4eff8 100644
--- a/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/common/Rect.h
+++ b/src/Microsoft.DotNet.Wpf/src/WpfGfx/core/common/Rect.h
@@ -33,11 +33,17 @@
 //
 //-----------------------------------------------------------------------------
 
-template <typename TBaseMILRect, typename Space>
+// Whether TBaseMILRect is one of the TMilRect_ wrappers (declares
+// HasBaseType).  MSVC's build selects the class body with a class-scope
+// __if_exists, which clang cannot evaluate for dependent names.
+template <typename T, typename = void>
+struct TRect_HasBaseType { static const bool value = false; };
+template <typename T>
+struct TRect_HasBaseType<T, decltype(&T::HasBaseType, void())> { static const bool value = true; };
+
+template <typename TBaseMILRect, typename Space, bool = TRect_HasBaseType<TBaseMILRect>::value>
 class TRect_ : public TBaseMILRect
 {
-  __if_exists (TBaseMILRect::HasBaseType)
-  {
 protected:
 
     //+------------------------------------------------------------------------
@@ -177,8 +183,13 @@ public:
         return reinterpret_cast<const TRect_ *>(base);
     }
 
-  }
+};
 
+// Without HasBaseType the class is empty (the __if_exists block above was
+// skipped for such bases).
+template <typename TBaseMILRect, typename Space>
+class TRect_<TBaseMILRect, Space, false> : public TBaseMILRect
+{
 };
 
 
@@ -199,6 +210,11 @@ public:
 template <typename Space> 
 class CRectF : public TRect_<CMilRectF, Space>
 {
+protected:
+    // Also declared by the base; restated because names from a dependent
+    // base class are not found in declarations outside MSVC.
+    typedef CMilRectF BaseMILRectType;
+
 public:
 
     //=========================================================================
