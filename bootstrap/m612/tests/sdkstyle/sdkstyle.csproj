<Project Sdk="Microsoft.NET.Sdk">
  <!-- An SDK-style project (Microsoft.NET.Sdk from source, net472 tasks) built by
       the source-built MSBuild on Mono.  Restore runs against an empty local feed:
       nothing is downloaded. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreSources>$(MSBuildThisFileDirectory)emptyfeed</RestoreSources>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
</Project>
