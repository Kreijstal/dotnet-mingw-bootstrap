+ExprResult cppcliConvertReturn(Sema &Actions, Scope *CurrentScope,
+    Preprocessor &PP, Expr *Argument, QualType Target, SourceLocation Loc) {
+  bool Object=cppcliNamedHandle(Target,"System::Object");
+  if(Object && cppcliInterfaceHandle(Argument->getType()))
+    return cppcliInterfaceObject(Actions,CurrentScope,PP,Argument,Loc);
+  if(Object && (Argument->getType()->isArithmeticType() || Argument->getType()->isEnumeralType()))
+    return cppcliBoxObject(Actions,CurrentScope,PP,Argument,Loc);
+  if((Object || cppcliNamedHandle(Target,"System::String")) && isa<StringLiteral>(Argument->IgnoreParenImpCasts())) {
+    CXXScopeSpec Global; UnqualifiedId Name;
+    Global.MakeGlobal(Actions.Context,Loc);
+    Name.setIdentifier(&PP.getIdentifierTable().get("__cli_literal"),Loc);
+    auto Helper=Actions.ActOnIdExpression(CurrentScope,Global,SourceLocation(),Name,true,false);
+    if(Helper.isInvalid()) return ExprError();
+    return Actions.ActOnCallExpr(CurrentScope,Helper.get(),Loc,
+        llvm::MutableArrayRef<Expr *>(&Argument,1),Argument->getEndLoc());
+  }
+  return Argument;
+}
