+static bool cppcliInterfaceHandle(QualType Type) {
+  auto *Record=Type->isPointerType() ? Type->getPointeeType()->getAsCXXRecordDecl() : nullptr;
+  if(!Record) return false;
+  if(Record->getDefinition()) Record=Record->getDefinition();
+  for(auto *Attr:Record->specific_attrs<AnnotateAttr>()) if(Attr->getAnnotation()=="cli.interface") return true;
+  return false;
