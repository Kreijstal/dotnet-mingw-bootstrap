+static bool cppcliNamedHandle(QualType Type, StringRef Name) {
+  auto *Record=Type->isPointerType() ? Type->getPointeeType()->getAsCXXRecordDecl() : nullptr;
+  return Record && Record->getQualifiedNameAsString()==Name;
+}
