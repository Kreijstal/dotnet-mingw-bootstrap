+// Resolve the scalar width/kind, then let the selected metadata facade carry
+// ordinary C++ overload/access lookup for the actual CLR primitive methods.
+static ExprResult cppcliPrimitiveReceiver(Sema &Actions, Scope *CurrentScope,
+    Preprocessor &PP, Expr *Value, SourceLocation Loc) {
+  auto Type=Value->getType();
+  if(!Type->isArithmeticType()) return Value;
+  std::string Name;
+  if(Type->isBooleanType()) Name="Boolean";
+  else if(Type->isSpecificBuiltinType(BuiltinType::Char16) ||
+      (Type->isWideCharType() && Actions.Context.getTypeSize(Type)==16)) Name="Char";
+  else if(Type->isIntegerType()) {
+    auto Bits=Actions.Context.getTypeSize(Type);
+    if(Bits==8) Name=Type->isUnsignedIntegerType() ? "Byte" : "SByte";
+    else if(Bits==16 || Bits==32 || Bits==64) Name=(Type->isUnsignedIntegerType() ? "UInt" : "Int")+std::to_string(Bits);
+  } else if(Type->isRealFloatingType()) {
+    auto Bits=Actions.Context.getTypeSize(Type);
+    if(Bits==32) Name="Single";
+    else if(Bits==64) Name="Double";
+  }
+  if(Name.empty()) return Value;
+  auto *Identifier=&PP.getIdentifierTable().get("__cli_primitive_box_"+Name);
+  LookupResult Lookup(Actions,Identifier,Loc,Sema::LookupOrdinaryName);
+  if(!Actions.LookupQualifiedName(Lookup,Actions.Context.getTranslationUnitDecl())) return Value;
+  CXXScopeSpec Global; Global.MakeGlobal(Actions.Context,Loc);
+  UnqualifiedId Helper; Helper.setIdentifier(Identifier,Loc);
+  auto Function=Actions.ActOnIdExpression(CurrentScope,Global,SourceLocation(),Helper,true,false);
+  if(Function.isInvalid()) return ExprError();
+  return Actions.ActOnCallExpr(CurrentScope,Function.get(),Loc,
+      MutableArrayRef<Expr *>(&Value,1),Value->getEndLoc());
+}
+
+static ExprResult cppcliBoxObject(Sema &Actions, Scope *CurrentScope,
+    Preprocessor &PP, Expr *Argument, SourceLocation Loc) {
+  CXXScopeSpec Global; UnqualifiedId Name;
+  Global.MakeGlobal(Actions.Context,Loc);
+  Name.setIdentifier(&PP.getIdentifierTable().get("__cli_box_object"),Loc);
+  auto Helper=Actions.ActOnIdExpression(CurrentScope,Global,SourceLocation(),Name,true,false);
+  if(Helper.isInvalid()) return ExprError();
+  return Actions.ActOnCallExpr(CurrentScope,Helper.get(),Loc,
+      llvm::MutableArrayRef<Expr *>(&Argument,1),Argument->getEndLoc());
+}
