+namespace clang {
+ExprResult cppcliTryUnbox(Sema &Actions, Scope *CurrentScope, Preprocessor &PP,
+    Expr *Argument, Declarator &DeclaratorInfo, SourceLocation Loc) {
+  if(!Argument || Argument->getType().isNull()) return ExprResult();
+  if(Argument->getType()->isSpecificBuiltinType(BuiltinType::PseudoObject)) {
+    auto Resolved=Actions.CheckPlaceholderExpr(Argument);
+    if(Resolved.isInvalid()) return ExprError();
+    Argument=Resolved.get();
+  }
+  if(!cppcliNamedHandle(Argument->getType(),"System::Object")) return ExprResult();
+  auto *TypeInfo=Actions.GetTypeForDeclaratorCast(DeclaratorInfo,Argument->getType());
+  if(!TypeInfo) return ExprError();
+  auto Target=TypeInfo->getType();
+  bool ManagedValue=false;
+  if(auto *Record=Target->getAsCXXRecordDecl()) {
+    if(Record->getDefinition()) Record=Record->getDefinition();
+    for(auto *Attr:Record->specific_attrs<AnnotateAttr>()) ManagedValue |= Attr->getAnnotation()=="cli.value";
+  }
+  if(!Target->isArithmeticType() && !cppcliEnum(Target) && !ManagedValue) return ExprResult();
+  CXXScopeSpec Global; Global.MakeGlobal(Actions.Context,Loc);
