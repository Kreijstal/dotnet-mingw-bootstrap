+bool cppcliConvertConstructorArguments(Sema &Actions, Scope *CurrentScope,
+    Preprocessor &PP, QualType Type, MutableArrayRef<Expr *> Arguments,
+    SourceLocation Loc) {
+  auto *Record=Type.isNull() ? nullptr : Type->getAsCXXRecordDecl();
+  if(!Record || !Record->getDefinition()) return false;
+  Record=Record->getDefinition();
+  for(unsigned Index=0;Index<Arguments.size();++Index) {
+    QualType Target;
+    if(isa<StringLiteral>(Arguments[Index]->IgnoreParenImpCasts())) {
+      for(auto *Constructor:Record->ctors())
+        if(cppcliStringSlot(Constructor,Index,Arguments.size())) {
+          Target=Constructor->getParamDecl(Index)->getType(); break;
+        }
+    } else if(Arguments[Index]->getType()->isArithmeticType() || Arguments[Index]->getType()->isEnumeralType()) {
+      bool Found=false,AllObject=true;
+      for(auto *Constructor:Record->ctors()) {
+        if(Constructor->isCopyOrMoveConstructor() || Index>=Constructor->getNumParams() ||
+            Arguments.size()>Constructor->getNumParams() || Arguments.size()<Constructor->getMinRequiredArguments()) continue;
+        Found=true;
+        auto Candidate=Constructor->getParamDecl(Index)->getType();
+        AllObject &= cppcliStringSlot(Constructor,Index,Arguments.size()) && cppcliNamedHandle(Candidate,"System::Object");
+        Target=Candidate;
+      }
+      if(!Found || !AllObject) Target={};
+    }
+    if(Target.isNull()) continue;
+    auto Converted=cppcliConvertReturn(Actions,CurrentScope,PP,Arguments[Index],Target,Loc);
+    if(Converted.isInvalid()) return true;
+    Arguments[Index]=Converted.get();
+  }
+  return false;
+}
