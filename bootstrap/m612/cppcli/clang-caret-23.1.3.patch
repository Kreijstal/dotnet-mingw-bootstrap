+static QualType cppcliAssignmentType(Expr *Value) {
+  QualType Type=Value->getType();
+  Expr *Base=Value->IgnoreParens();
+  while (auto *Subscript=dyn_cast<MSPropertySubscriptExpr>(Base)) Base=Subscript->getBase()->IgnoreParens();
+  if(auto *Property=dyn_cast<MSPropertyRefExpr>(Base)) {
+    Type=Property->getPropertyDecl()->getType();
+    if(Type->isIncompleteArrayType()) Type=cast<ArrayType>(Type.getTypePtr())->getElementType();
+  }
+  return Type;
+}
