+// CLI enum operations retain their scoped type identity. Sema still checks
+// explicit conversions and native operations; ordinary C++ enums are untouched.
+static const EnumDecl *cppcliEnum(QualType Type) {
+  auto *Enum = Type->getAs<EnumType>();
+  if (!Enum)
+    return nullptr;
+  auto *Decl = Enum->getDecl();
+  if (Decl->getDefinition())
+    Decl = Decl->getDefinition();
+  for (auto *Attr : Decl->specific_attrs<AnnotateAttr>())
+    if (Attr->getAnnotation() == "cli.enum")
+      return Decl;
+  return nullptr;
+}
+
+static const MemberExpr *cppcliEvent(Expr *Value) {
+  auto *Member = dyn_cast<MemberExpr>(Value->IgnoreParenImpCasts());
+  if (!Member) return nullptr;
+  for (auto *Attr : Member->getMemberDecl()->specific_attrs<AnnotateAttr>())
+    if (Attr->getAnnotation() == "cli.event") return Member;
+  return nullptr;
+}
+
+static ExprResult cppcliEventAccessor(Sema &Actions, Scope *CurrentScope,
+    Preprocessor &PP, Expr *Value, StringRef Accessor, SourceLocation Loc) {
+  auto *Event = cppcliEvent(Value);
+  assert(Event);
+  std::string Name = Accessor.str() + "_" + Event->getMemberDecl()->getNameAsString();
+  std::string Prefix = "cli.event." + Accessor.str() + ":";
+  for (auto *Attr : Event->getMemberDecl()->specific_attrs<AnnotateAttr>())
+    if (Attr->getAnnotation().starts_with(Prefix)) Name = Attr->getAnnotation().drop_front(Prefix.size()).str();
+  CXXScopeSpec Scope; UnqualifiedId Member;
+  Member.setIdentifier(&PP.getIdentifierTable().get(Name), Loc);
+  return Actions.ActOnMemberAccessExpr(CurrentScope, Event->getBase(), Loc,
+      Event->isArrow() ? tok::arrow : tok::period, Scope, SourceLocation(), Member, nullptr);
+}
+
+static ExprResult cppcliEnumCast(Sema &Actions, Expr *Value, QualType Type,
+                                SourceLocation Loc) {
+  return Actions.BuildCStyleCastExpr(
+      Loc, Actions.Context.getTrivialTypeSourceInfo(Type, Loc), Loc, Value);
+}
