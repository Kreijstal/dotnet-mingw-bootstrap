+// CLI enum operations retain their scoped type identity. Sema still checks
+// explicit conversions and native operations; ordinary C++ enums are untouched.
+static const EnumDecl *cppcliEnum(QualType Type) {
+  auto *Enum = Type->getAs<EnumType>();
+  if (!Enum)
+    return nullptr;
+  auto *Decl = Enum->getDecl();
+  if (Decl->getDefinition())
+    Decl = Decl->getDefinition();
+  for (auto *Attr : Decl->specific_attrs<AnnotateAttr>())
+    if (Attr->getAnnotation() == "cli.enum")
+      return Decl;
+  return nullptr;
+}
+
+static ExprResult cppcliEnumCast(Sema &Actions, Expr *Value, QualType Type,
+                                SourceLocation Loc) {
+  return Actions.BuildCStyleCastExpr(
+      Loc, Actions.Context.getTrivialTypeSourceInfo(Type, Loc), Loc, Value);
+}
